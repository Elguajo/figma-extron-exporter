{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/singleScreen"
    },
    {
      "$ref": "#/$defs/projectScreen"
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*(?![\\s\\S])",
      "maxLength": 100
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "color": {
      "type": "string",
      "pattern": "^#[A-Fa-f0-9]{6}(?![\\s\\S])"
    },
    "alphaColor": {
      "type": "string",
      "pattern": "^#(?:[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})(?![\\s\\S])"
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "size",
        "bold"
      ],
      "properties": {
        "family": {
          "enum": [
            "Arial",
            "Inter",
            "Inter Display"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 4,
          "maximum": 200
        },
        "bold": {
          "type": "boolean"
        },
        "style": {
          "enum": [
            "Thin",
            "Extra Light",
            "Light",
            "Regular",
            "Medium",
            "Semi Bold",
            "Bold",
            "Extra Bold",
            "Black",
            "Thin Italic",
            "Extra Light Italic",
            "Light Italic",
            "Italic",
            "Medium Italic",
            "Semi Bold Italic",
            "Bold Italic",
            "Extra Bold Italic",
            "Black Italic"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "name",
        "role",
        "text",
        "fill",
        "textColor"
      ],
      "properties": {
        "stateId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "normal",
            "feedback",
            "pressed"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 256
        },
        "fill": {
          "$ref": "#/$defs/alphaColor"
        },
        "textColor": {
          "$ref": "#/$defs/color"
        },
        "image": {
          "$ref": "#/$defs/key"
        },
        "imageAlign": {
          "enum": [
            "top-center",
            "middle-center"
          ]
        },
        "textAlign": {
          "enum": [
            "bottom-center",
            "middle-center"
          ]
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "objectId",
        "controlId",
        "name",
        "rect",
        "kind",
        "font",
        "states"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "objectId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "controlId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "rect": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1280
          }
        },
        "kind": {
          "const": "button"
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "press": {
          "$ref": "#/$defs/text"
        },
        "navigate": {
          "$ref": "#/$defs/key"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "objectId",
        "controlId",
        "name",
        "rect",
        "kind",
        "text",
        "textColor",
        "font"
