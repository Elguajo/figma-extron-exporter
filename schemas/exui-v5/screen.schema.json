          "$ref": "#/$defs/text"
        },
        "textColor": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "textAlign": {
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "middle-left",
            "middle-center",
            "middle-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ]
        }
      }
    },
    "level": {
      "type": "object",
