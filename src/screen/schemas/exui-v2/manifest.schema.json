{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "screen",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "exui/2"
    },
    "profile": {
      "enum": [
        "tlp-pro-1025m",
        "tlp-pro-300m-portrait"
      ]
    },
    "screen": {
      "const": "screen.json"
    },
    "resources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/[a-z0-9][a-z0-9-]{0,63}\\.png(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}(?![\\s\\S])"
          }
        }
      }
    }
  }
}