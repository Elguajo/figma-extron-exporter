{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "@figma/plugin-typings"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/metadata-types.ts"
  ],
  "exclude": [
    "src/ui.ts",
    "src/package.ts"
  ]
}
