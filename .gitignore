.tools/
**/bin/
**/obj/
output/
tmp/
**/__pycache__/
samples/original/*
!samples/original/.gitkeep
*.user
samples/donors/*
!samples/donors/.gitkeep
# Private GDL fixtures for tests and packaging (derived from donors).
samples/fixtures/
**/node_modules/
src/figma-plugin/dist/
docs/web/extron-kit-docs/dist/
releases/figma-plugin/**/unpacked/
releases/figma-plugin/**/figma-extron-plugin-*/
verification/results/**/*.gdl
# Stable release archives live next to their release notes but stay out of git; checksums are tracked.
/releases/**/*.zip
# Unpacked updater builds remain local; retain only release notes and launchers.
/releases/LayoutUpdater/**
!/releases/LayoutUpdater/**/
!/releases/LayoutUpdater/**/README.md
!/releases/LayoutUpdater/**/SHA256SUMS.txt
!/releases/LayoutUpdater/**/Start-LayoutUpdater.cmd
# Local archive of old scratch outputs, extracted release copies and generated GDLs.
/archive/
